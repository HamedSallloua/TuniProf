# Copy this file to .env.local and replace the placeholders.
# .env.local is private and is never committed to git.

# Development database (see db/setup-local.sql).
DATABASE_URL=postgresql://tuniprof_app:CHANGE_ME@localhost:5432/tuniprof_dev

# Test database, used by npm test and the db:*:test scripts.
TEST_DATABASE_URL=postgresql://tuniprof_app:CHANGE_ME@localhost:5432/tuniprof_test

# Secret used to hash verification codes, devices and addresses. At least 32 random
# characters. Make one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Changing it later invalidates pending verification codes (people just ask for a new one).
AUTH_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS

# Folder for uploaded photos in development (default: ./uploads, ignored by git).
# STORAGE_LOCAL_DIR=

# dev-stub: local work, a button simulates the WhatsApp message. whatsapp: the real thing.
# Production always uses whatsapp, whatever this says.
VERIFICATION_PROVIDER=dev-stub

# Only for VERIFICATION_PROVIDER=whatsapp (from the Meta Business account, spec 13.2).
# WHATSAPP_PLATFORM_NUMBER: the number people message, digits only with country code.
# WHATSAPP_APP_SECRET: used to check that webhook calls really come from Meta.
# WHATSAPP_VERIFY_TOKEN: a text you invent, typed in the Meta webhook setup screen.
WHATSAPP_PLATFORM_NUMBER=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
